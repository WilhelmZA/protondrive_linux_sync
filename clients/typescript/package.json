{
  "name": "@neutronsync/client",
  "version": "0.9.1",
  "private": true,
  "description": "TypeScript client for the NeutronSync HTTP API",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "bash generate.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter spec test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
