#!/command/with-contenv bash
set -euo pipefail

UMASK="${UMASK:-002}"
umask "$UMASK"

CONFIG_ROOT="${NEUTRONSYNC_CONFIG_ROOT:-/config}"
export NEUTRONSYNC_API_TOKEN_FILE="${NEUTRONSYNC_API_TOKEN_FILE:-${CONFIG_ROOT}/secrets/api.token}"

WEB_AUTH="${NEUTRONSYNC_WEB_AUTH:-password}"
case "$WEB_AUTH" in
	password | proxy) ;;
	*)
		echo "NEUTRONSYNC_WEB_AUTH must be 'password' or 'proxy', got ${WEB_AUTH}."
		sleep 5
		exit 1
		;;
esac

run_web() {
	exec neutronsync-web
}

if [ "$(id -u)" -eq 0 ]; then
	exec s6-setuidgid abc neutronsync-web
else
	run_web
fi
